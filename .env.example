# Copy to `.env.local` for local development. On Vercel, set the same keys in
# Project Settings → Environment Variables.

# The BEP-20 contract address on BNB Smart Chain, once it exists.
#
# This one variable switches the whole on-chain layer on. While it is empty the
# site says so plainly — no address, a disabled buy button, em-dashes instead of
# figures — and nothing needs editing at launch beyond filling it in.
#
# It is NEXT_PUBLIC_ because the browser needs it to read a visitor's balance.
# There is no secret here: a contract address is public by definition.
#
# A malformed value is ignored rather than passed through, so a typo cannot end
# up inside a BscScan or PancakeSwap link.
NEXT_PUBLIC_MOTH_ADDRESS=

# Canonical origin, used as the base for OG and Twitter card image URLs.
# Vercel supplies its own production host when this is unset; set it once a
# custom domain is in front of the deployment.
NEXT_PUBLIC_SITE_URL=
