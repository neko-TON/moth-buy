# Copy to `.env.local` for local development. On Vercel, set the same keys in
# Project Settings → Environment Variables.


# ---------------------------------------------------------------- admin panel

# The password for /admin, which sets the contract address shown to visitors.
#
# Generate it, do not invent it:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Minimum 16 characters. Below that — or unset — /admin does not exist at all
# and returns a 404: no login form to attack, and no default credential sitting
# in this repository for someone to try.
ADMIN_PASSWORD=

# Signs the admin session cookie, and signs the stored address record so that a
# leaked store credential is not on its own enough to change what visitors copy.
# Minimum 32 characters:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Changing it signs everyone out and invalidates the stored address, which then
# reads as unset until it is saved again.
ADMIN_SESSION_SECRET=


# ---------------------------------------------------------------------- store

# Where the contract address lives so that saving it reaches every visitor at
# once, with no redeploy.
#
# On Vercel: Storage → Create Database → Upstash → Redis, free tier. Both
# variables are then injected automatically and there is nothing to paste here.
# Variables from a database created directly at upstash.com work too, under
# their own names (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
#
# Left empty in local development the site falls back to a file at
# .data/store.json. That fallback is refused on Vercel rather than used: a
# serverless instance's own disk would accept the write, show it back to
# whoever saved it, reach nobody else, and vanish at the next cold start.
KV_REST_API_URL=
KV_REST_API_TOKEN=


# ----------------------------------------------------------------------- site

# Canonical origin, used as the base for OG and Twitter card image URLs.
# Vercel supplies its own production host when this is unset; set it once a
# custom domain is in front of the deployment.
NEXT_PUBLIC_SITE_URL=
